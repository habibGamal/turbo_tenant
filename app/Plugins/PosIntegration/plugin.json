{
    "id": "pos-integration",
    "name": "Point of Sale (POS) Integration",
    "version": "1.0.0",
    "category": "addon",
    "description": "Modular Point of Sale (POS) Integration plugin for Turbo Tenant",
    "author": "Turbo Tenant Team",
    "is_core": false,
    "dependencies": [
        "order-management",
        "catalog-products",
        "locations-delivery",
        "store-settings"
    ],
    "providers": [
        "App\\Plugins\\PosIntegration\\PosIntegrationServiceProvider"
    ],
    "filament": "App\\Plugins\\PosIntegration\\src\\Filament\\PosIntegrationFilamentPlugin",
    "listeners": {
        "App\\Plugins\\OrderManagement\\src\\Events\\OrderCreated": [
            "App\\Plugins\\PosIntegration\\src\\Listeners\\SendOrderToPosListener@handleOrderCreated"
        ],
        "App\\Plugins\\OrderManagement\\src\\Events\\OrderStatusUpdated": [
            "App\\Plugins\\PosIntegration\\src\\Listeners\\SendOrderToPosListener@handleStatusUpdated"
        ],
        "App\\Plugins\\OrderManagement\\src\\Events\\OrderPaymentCompleted": [
            "App\\Plugins\\PosIntegration\\src\\Listeners\\SendOrderToPosListener@handleOrderPaymentCompleted"
        ],
        "App\\Plugins\\OrderManagement\\src\\Events\\OrderFinalized": [
            "App\\Plugins\\PosIntegration\\src\\Listeners\\SendOrderToPosListener@handleOrderFinalized"
        ]
    },
    "tenant_scoped": [
        "App\\Plugins\\PosIntegration\\src\\DTOs\\PosIntegrationConfig",
        "App\\Plugins\\PosIntegration\\src\\Services\\POS\\Contracts\\POSApiClientInterface",
        "App\\Plugins\\PosIntegration\\src\\Services\\POS\\Contracts\\POSProductResolverInterface",
        "App\\Plugins\\PosIntegration\\src\\Services\\POS\\POSCustomerDataFormatter",
        "App\\Plugins\\PosIntegration\\src\\Services\\POS\\Contracts\\OrderPOSPayloadBuilderInterface"
    ]
}