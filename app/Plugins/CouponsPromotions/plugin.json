{
  "id": "coupons-promotions",
  "name": "Coupons & Promotional Discounts",
  "version": "1.0.0",
  "category": "marketing",
  "description": "Modular plugin for Turbo Tenant",
  "author": "Turbo Tenant Team",
  "is_core": false,
  "dependencies": [
    "cart-engine",
    "order-management",
    "catalog-products",
    "locations-delivery"
  ],
  "providers": [
    "App\\Plugins\\CouponsPromotions\\CouponsPromotionsServiceProvider"
  ],
  "filament": "App\\Plugins\\CouponsPromotions\\src\\Filament\\CouponsPromotionsFilamentPlugin",
  "listeners": {
    "App\\Plugins\\OrderManagement\\src\\Events\\OrderCreated": [
      "App\\Plugins\\CouponsPromotions\\src\\Listeners\\RecordCouponUsageListener"
    ]
  },
  "tenant_scoped": [
    "App\\Plugins\\CouponsPromotions\\src\\DTOs\\CouponsPromotionsConfig",
    "App\\Plugins\\CouponsPromotions\\src\\Services\\CouponService"
  ]
}