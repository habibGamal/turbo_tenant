{
  "id": "order-management",
  "name": "Order Management & Checkout Core",
  "version": "1.0.0",
  "category": "foundation",
  "description": "Order records, order placement pipeline, status state machine, and customer order history.",
  "author": "Turbo Tenant Team",
  "is_core": false,
  "dependencies": [
    "cart-engine",
    "locations-delivery",
    "catalog-products",
    "store-settings"
  ],
  "providers": [
    "App\\Plugins\\OrderManagement\\OrderManagementServiceProvider"
  ],
  "filament": "App\\Plugins\\OrderManagement\\src\\Filament\\OrderManagementFilamentPlugin",
  "listeners": {
    "App\\Plugins\\OrderManagement\\src\\Events\\OrderCreated": [
      "App\\Plugins\\OrderManagement\\src\\Listeners\\NotifyAdminsOfNewOrder"
    ]
  },
  "tenant_scoped": [
    "App\\Plugins\\OrderManagement\\src\\Pipelines\\OrderPipelineRegistry",
    "App\\Plugins\\OrderManagement\\src\\Pipelines\\OrderValidationPipeline",
    "App\\Plugins\\OrderManagement\\src\\Pipelines\\PricingCalculationPipeline",
    "App\\Plugins\\OrderManagement\\src\\DTOs\\OrderManagementConfig"
  ]
}