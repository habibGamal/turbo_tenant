{
  "id": "cart-engine",
  "name": "Cart & Calculations Engine",
  "version": "1.0.0",
  "category": "foundation",
  "description": "Cart storage, line-item modifiers, pricing calculation, and cart synchronization.",
  "author": "Turbo Tenant Team",
  "is_core": false,
  "dependencies": [
    "catalog-products",
    "store-settings"
  ],
  "providers": [
    "App\\Plugins\\CartEngine\\CartEngineServiceProvider"
  ],
  "listeners": {
    "Illuminate\\Auth\\Events\\Login": [
      "App\\Plugins\\CartEngine\\src\\Listeners\\SyncGuestCartOnLogin"
    ]
  },
  "tenant_scoped": [
    "App\\Plugins\\CartEngine\\src\\Services\\CartService"
  ]
}