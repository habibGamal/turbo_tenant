{
    "id": "push-notifications",
    "name": "Push & Bulk Notifications",
    "version": "1.0.0",
    "category": "communication",
    "description": "Modular Push & Bulk Notifications plugin for Turbo Tenant",
    "author": "Turbo Tenant Team",
    "is_core": false,
    "dependencies": [
        "order-management"
    ],
    "providers": [
        "App\\Plugins\\PushNotifications\\PushNotificationsServiceProvider"
    ],
    "filament": "App\\Plugins\\PushNotifications\\src\\Filament\\PushNotificationsFilamentPlugin",
    "listeners": {
        "App\\Plugins\\OrderManagement\\src\\Events\\OrderCreated": [
            "App\\Plugins\\PushNotifications\\src\\Listeners\\SendOrderStatusNotificationListener"
        ],
        "App\\Plugins\\OrderManagement\\src\\Events\\OrderStatusUpdated": [
            "App\\Plugins\\PushNotifications\\src\\Listeners\\SendOrderStatusNotificationListener"
        ]
    },
    "tenant_scoped": [
        "App\\Plugins\\PushNotifications\\src\\DTOs\\PushNotificationsConfig"
    ]
}