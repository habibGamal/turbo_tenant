{
  "id": "guest-checkout",
  "name": "Guest Checkout & Order Tracking",
  "version": "1.0.0",
  "category": "commerce",
  "description": "Modular plugin for Turbo Tenant",
  "author": "Turbo Tenant Team",
  "is_core": false,
  "dependencies": [
    "order-management",
    "locations-delivery"
  ],
  "providers": [
    "App\\Plugins\\GuestCheckout\\GuestCheckoutServiceProvider"
  ],
  "plugin": "App\\Plugins\\GuestCheckout\\GuestCheckoutPlugin",
  "filament": "App\\Plugins\\GuestCheckout\\src\\Filament\\GuestCheckoutFilamentPlugin",
  "listeners": {
    "App\\Plugins\\OrderManagement\\src\\Events\\OrderCreated": [
      "App\\Plugins\\GuestCheckout\\src\\Listeners\\RememberGuestOrderSession"
    ]
  },
  "tenant_scoped": [
    "App\\Plugins\\GuestCheckout\\src\\Services\\GuestUserService"
  ]
}
